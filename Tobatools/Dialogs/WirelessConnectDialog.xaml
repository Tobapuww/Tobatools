<ContentDialog
    x:Class="Tobatools.Dialogs.WirelessConnectDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="无线连接设备"
    PrimaryButtonText="连接"
    CloseButtonText="取消"
    DefaultButton="Primary"
    PrimaryButtonClick="OnPrimaryClick">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="12" MinWidth="320" MaxWidth="520">
            <TextBlock Text="无线调试配对（可选）" Style="{StaticResource CardTitleStyle}"/>
            <TextBlock Text="Android 11 及以上：打开“开发者选项 → 无线调试 → 使用配对码配对设备”。配对与连接使用不同端口。"
                       Style="{StaticResource CaptionTextStyle}"/>

            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="PairHost" PlaceholderText="配对 IP:端口" Header="配对地址"
                         Style="{StaticResource RoundedTextBoxStyle}"/>
                <TextBox x:Name="PairCode" Grid.Column="1" PlaceholderText="6 位数字" Header="配对码" MaxLength="6"
                         Style="{StaticResource RoundedTextBoxStyle}"/>
            </Grid>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="BtnPair" Content="配对" Style="{StaticResource DefaultButtonStyle}"
                        Click="OnPairClick"/>
                <Button x:Name="BtnAutoPair" Content="自动发现并配对" Style="{StaticResource DefaultButtonStyle}"
                        Click="OnAutoPairClick"/>
                <Button x:Name="BtnRestartAdb" Content="重启 ADB" Style="{StaticResource DefaultButtonStyle}"
                        Click="OnRestartAdbClick"/>
            </StackPanel>
            <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>

            <TextBlock Text="连接设备" Style="{StaticResource CardTitleStyle}"/>
            <TextBox x:Name="ConnectHost" PlaceholderText="IP:端口，例如 127.0.0.1:5555" Header="连接地址"
                     Style="{StaticResource RoundedTextBoxStyle}"/>
            <TextBlock Text="手机：使用无线调试主页的 IP 地址和端口。传统 TCP 调试默认端口为 5555，设备需已开启该服务。"
                       Style="{StaticResource CaptionTextStyle}"/>
            <TextBlock Text="模拟器：使用它公布的本机 ADB 映射地址。10.0.2.15 常是内部 NAT 地址，不能代替电脑上的映射端口。"
                       Style="{StaticResource CaptionTextStyle}"/>

            <Button x:Name="BtnDisconnect" Content="断开当前连接" Style="{StaticResource DefaultButtonStyle}"
                    HorizontalAlignment="Left" Click="OnDisconnectClick"/>

            <ProgressRing x:Name="Busy" IsActive="False" Visibility="Collapsed" Width="24" Height="24"
                          HorizontalAlignment="Left" AutomationProperties.Name="正在执行无线连接请求"/>
            <InfoBar x:Name="ResultNotice" IsOpen="False" IsClosable="False">
                <TextBlock x:Name="TxtResult" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                           Style="{StaticResource BodyTextStyle}"/>
            </InfoBar>
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
