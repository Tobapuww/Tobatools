<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Tobatools.Controls.PageHeader"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Name="HeaderRoot">
    <Grid ColumnSpacing="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Style="{StaticResource IconBadgeStyle}" Width="48" Height="48" VerticalAlignment="Center">
            <!-- 图标几何来自 Python 原版 FluentIcon SVG，故用 PathIcon 而非字体图标。 -->
            <PathIcon x:Name="GlyphIcon" Width="24" Height="24"
                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
        </Border>
        <StackPanel Grid.Column="1" Spacing="4">
            <TextBlock Text="{Binding Title, ElementName=HeaderRoot}" Style="{StaticResource PageTitleStyle}"
                       AutomationProperties.HeadingLevel="Level1"/>
            <TextBlock Text="{Binding Subtitle, ElementName=HeaderRoot}" Style="{StaticResource CardSubtitleStyle}"/>
        </StackPanel>
    </Grid>
</UserControl>
