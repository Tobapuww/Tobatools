<UserControl
    x:Class="Tobatools.Controls.DeviceBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:loc="using:Tobatools.Services"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignWidth="900" d:DesignHeight="48">

    <Border Background="Transparent" Padding="24,12">
        <Grid ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- 状态点 -->
            <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="#86909c"
                     VerticalAlignment="Center" Margin="4,0,0,0"/>

            <!-- 状态文字 -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                <TextBlock x:Name="TxtStatus" Text="{loc:Loc Key=Pages/Dashboard_051}" FontSize="13"
                           FontFamily="{StaticResource AppFont}" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" TextWrapping="Wrap"/>
                <TextBlock x:Name="TxtSerial" Text="{loc:Loc Key=Pages/DeviceBar_001}" FontSize="11"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           FontFamily="{StaticResource AppFont}" TextTrimming="CharacterEllipsis" TextWrapping="Wrap"/>
            </StackPanel>

            <!-- 连接 -->
            <Button x:Name="BtnConnect" Grid.Column="2" Style="{StaticResource DefaultButtonStyle}"
                    Click="OnConnectClick">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE774;" FontSize="14"/>
                    <TextBlock Text="{loc:Loc Key=Pages/Dashboard_007}" TextWrapping="Wrap"/>
                </StackPanel>
            </Button>

            <!-- 刷新 -->
            <Button x:Name="BtnRefresh" Grid.Column="3" Style="{StaticResource DefaultButtonStyle}"
                    ToolTipService.ToolTip="{loc:Loc Key=Pages/DeviceBar_002}" Click="OnRefreshClick">
                <FontIcon Glyph="&#xE72C;" FontSize="14"/>
            </Button>

            <!-- 重启 -->
            <Button x:Name="BtnReboot" Grid.Column="4" Style="{StaticResource DefaultButtonStyle}"
                    ToolTipService.ToolTip="{loc:Loc Key=Pages/DeviceBar_003}" Click="OnRebootClick">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE895;" FontSize="14"/>
                    <FontIcon Glyph="&#xE70D;" FontSize="10"/>
                </StackPanel>
                <Button.Resources>
                    <TeachingTip x:Name="RebootTip" PreferredPlacement="Bottom" IsLightDismissEnabled="True"/>
                </Button.Resources>
            </Button>
        </Grid>
    </Border>
</UserControl>
