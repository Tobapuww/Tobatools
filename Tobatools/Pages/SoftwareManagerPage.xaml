<Page
    x:Class="Tobatools.Pages.SoftwareManagerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:loc="using:Tobatools.Services"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Tobatools.Controls"
    xmlns:local="using:Tobatools.Models">
    <Grid Background="{ThemeResource AppCanvasBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Style="{StaticResource PageContentStyle}">
                <controls:PageHeader Title="{loc:Loc Key=Pages/SoftwareManager_001}" Subtitle="{loc:Loc Key=Pages/SoftwareManager_002}" IconData="{StaticResource SoftwareGlyph}"/>
                <InfoBar x:Name="DeviceNotice" IsOpen="False" IsClosable="False" Severity="Informational"/>
                <controls:ResponsiveColumns FirstColumnWeight="5" SecondColumnWeight="6" Breakpoint="980">
                    <Border Style="{StaticResource CardBorderStyle}" VerticalAlignment="Top">
                        <StackPanel Spacing="12">
                            <TextBlock Text="{loc:Loc Key=Pages/SoftwareManager_003}" Style="{StaticResource CardTitleStyle}" TextWrapping="Wrap"/>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtSearch" PlaceholderText="{loc:Loc Key=Pages/SoftwareManager_004}" AutomationProperties.Name="{loc:Loc Key=Pages/SoftwareManager_005}"
                                         Style="{StaticResource RoundedTextBoxStyle}" TextChanged="OnSearchChanged"/>
                                <Button Grid.Column="1" Content="{loc:Loc Key=Pages/SoftwareManager_006}" Style="{StaticResource DefaultButtonStyle}" Click="OnRefreshApps"/>
                            </Grid>
                            <controls:WrapPanel Spacing="12">
                                <CheckBox x:Name="ChkSystem" Content="{loc:Loc Key=Pages/SoftwareManager_007}" Checked="OnRefreshApps" Unchecked="OnRefreshApps"/>
                                <Button Content="{loc:Loc Key=Pages/SoftwareManager_008}" Style="{StaticResource DefaultButtonStyle}" Click="OnClearSelected"/>
                            </controls:WrapPanel>
                            <ProgressBar x:Name="AppsProgress" IsIndeterminate="True" Visibility="Collapsed"/>
                            <ListView x:Name="ListApps" Height="440" SelectionMode="Single" SelectionChanged="OnAppSelected"
                                      AutomationProperties.Name="{loc:Loc Key=Pages/SoftwareManager_009}" ItemContainerStyle="{StaticResource AppListContainerStyle}">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="local:AppItem">
                                        <Grid Padding="4" ColumnSpacing="12">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <Border Style="{StaticResource IconBadgeStyle}" CornerRadius="10">
                                                <Grid>
                                                    <FontIcon Glyph="&#xE943;" Style="{StaticResource SectionIconStyle}"/>
                                                    <Image Source="{x:Bind Icon, Mode=OneWay}" Width="32" Height="32" Stretch="Uniform"/>
                                                </Grid>
                                            </Border>
                                            <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind Label, Mode=OneWay}" Style="{StaticResource BodyTextStyle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{x:Bind Pkg}" Style="{StaticResource CaptionTextStyle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <TextBlock x:Name="TxtAppCount" Text="{loc:Loc Key=Pages/SoftwareManager_010}" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    <StackPanel Spacing="16">
                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel Spacing="16">
                                <TextBlock Text="{loc:Loc Key=Pages/SoftwareManager_011}" Style="{StaticResource CardTitleStyle}" TextWrapping="Wrap"/>
                                <controls:WrapPanel Spacing="12">
                                    <CheckBox x:Name="ChkAutoRefresh" Content="{loc:Loc Key=Pages/SoftwareManager_012}" IsChecked="True"
                                              Checked="OnAutoRefreshChanged" Unchecked="OnAutoRefreshChanged"/>
                                    <Button Content="{loc:Loc Key=Pages/SoftwareManager_013}" Style="{StaticResource DefaultButtonStyle}" Click="OnRefreshState"/>
                                </controls:WrapPanel>
                                <Grid ColumnSpacing="12" RowSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <Border Style="{StaticResource InfoItemBorderStyle}">
                                        <StackPanel Spacing="6"><TextBlock Text="{loc:Loc Key=Pages/Dashboard_003}" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap"/><TextBlock x:Name="TxtDevice" Text="{loc:Loc Key=Pages/SoftwareManager_014}" Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap"/></StackPanel>
                                    </Border>
                                    <Border Grid.Column="1" Style="{StaticResource InfoItemBorderStyle}">
                                        <StackPanel Spacing="6"><TextBlock Text="{loc:Loc Key=Pages/SoftwareManager_015}" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap"/><TextBlock x:Name="TxtSelected" Text="{loc:Loc Key=Pages/SoftwareManager_016}" Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap"/></StackPanel>
                                    </Border>
                                    <Border Grid.Row="1" Style="{StaticResource InfoItemBorderStyle}">
                                        <StackPanel Spacing="6"><TextBlock Text="{loc:Loc Key=Pages/SoftwareManager_017}" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap"/><TextBlock x:Name="TxtFgPkg" Text="—" Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap"/></StackPanel>
                                    </Border>
                                    <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource InfoItemBorderStyle}">
                                        <StackPanel Spacing="6"><TextBlock Text="{loc:Loc Key=Pages/SoftwareManager_018}" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap"/><TextBlock x:Name="TxtFgAct" Text="—" Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap"/></StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel Spacing="16">
                                <TextBlock Text="{loc:Loc Key=Pages/SoftwareManager_019}" Style="{StaticResource CardTitleStyle}" TextWrapping="Wrap"/>
                                <ComboBox x:Name="ComboSection" AutomationProperties.Name="{loc:Loc Key=Pages/SoftwareManager_020}" Style="{StaticResource RoundedComboBoxStyle}" SelectionChanged="OnSectionChanged"/>
                                <StackPanel x:Name="SecInstall" Spacing="12">
                                    <TextBlock Text="{loc:Loc Key=Pages/SoftwareManager_021}" Style="{StaticResource CardSubtitleStyle}" TextWrapping="Wrap"/>
                                    <controls:WrapPanel Spacing="12">
                                        <CheckBox x:Name="ChkReinstall" Content="{loc:Loc Key=Pages/SoftwareManager_022}"/>
                                        <CheckBox x:Name="ChkDowngrade" Content="{loc:Loc Key=Pages/SoftwareManager_023}" Checked="OnDowngradeChanged"/>
                                    </controls:WrapPanel>
                                    <Button x:Name="BtnInstall" Content="{loc:Loc Key=Pages/SoftwareManager_024}" Style="{StaticResource AccentButtonStyle}" Click="OnInstallApk"/>
                                    <ProgressBar x:Name="InstallProgress" IsIndeterminate="True" Visibility="Collapsed"/>
                                </StackPanel>
                                <StackPanel x:Name="SecOps" Spacing="16" Visibility="Collapsed">
                                    <TextBlock Text="{loc:Loc Key=Pages/SoftwareManager_025}" Style="{StaticResource CardSubtitleStyle}" TextWrapping="Wrap"/>
                                    <controls:WrapPanel Spacing="8">
                                        <Button Content="{loc:Loc Key=Pages/SoftwareManager_026}" Style="{StaticResource DefaultButtonStyle}" Click="OnFreeze"/>
                                        <Button Content="{loc:Loc Key=Pages/SoftwareManager_027}" Style="{StaticResource DefaultButtonStyle}" Click="OnUnfreeze"/>
                                        <Button Content="{loc:Loc Key=Pages/SoftwareManager_028}" Style="{StaticResource DefaultButtonStyle}" Click="OnForceStop"/>
                                        <Button Content="{loc:Loc Key=Pages/SoftwareManager_029}" Style="{StaticResource DefaultButtonStyle}" Click="OnOpenPermissions"/>
                                        <Button Content="{loc:Loc Key=Pages/SoftwareManager_030}" Style="{StaticResource DefaultButtonStyle}" Click="OnPullApk"/>
                                    </controls:WrapPanel>
                                    <Border Style="{StaticResource CardBorderSubtleStyle}">
                                        <StackPanel Spacing="10">
                                            <TextBlock Text="{loc:Loc Key=Pages/SoftwareManager_031}" Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap"/>
                                            <controls:WrapPanel Spacing="8">
                                                <Button Content="{loc:Loc Key=Pages/SoftwareManager_032}" Style="{StaticResource DefaultButtonStyle}" Click="OnUninstall"/>
                                                <Button Content="{loc:Loc Key=Pages/SoftwareManager_033}" Style="{StaticResource DefaultButtonStyle}" Click="OnUninstallKeep"/>
                                                <Button Content="{loc:Loc Key=Pages/SoftwareManager_034}" Style="{StaticResource DefaultButtonStyle}" Click="OnClearData"/>
                                            </controls:WrapPanel>
                                        </StackPanel>
                                    </Border>
                                    <controls:WrapPanel Spacing="8">
                                        <Button Content="{loc:Loc Key=Pages/SoftwareManager_035}" Style="{StaticResource DefaultButtonStyle}" Click="OnDisableActivity"/>
                                        <CheckBox x:Name="ChkRootDisable" Content="{loc:Loc Key=Pages/SoftwareManager_036}"/>
                                        <Button Content="{loc:Loc Key=Pages/SoftwareManager_037}" Style="{StaticResource DefaultButtonStyle}" Click="OnOpenOplog"/>
                                    </controls:WrapPanel>
                                </StackPanel>
                                <StackPanel x:Name="SecComponent" Spacing="12" Visibility="Collapsed">
                                    <TextBlock Text="{loc:Loc Key=Pages/SoftwareManager_038}" Style="{StaticResource CardSubtitleStyle}" TextWrapping="Wrap"/>
                                    <Button Content="{loc:Loc Key=Pages/SoftwareManager_039}" Style="{StaticResource DefaultButtonStyle}" Click="OnRefreshDisabled"/>
                                    <ListView x:Name="ListDisabled" Height="160" SelectionMode="Single" AutomationProperties.Name="{loc:Loc Key=Pages/SoftwareManager_040}"/>
                                    <TextBox x:Name="TxtComponent" Header="{loc:Loc Key=Pages/SoftwareManager_041}" PlaceholderText="{loc:Loc Key=Pages/SoftwareManager_042}" Style="{StaticResource RoundedTextBoxStyle}"/>
                                    <Button Content="{loc:Loc Key=Pages/SoftwareManager_043}" Style="{StaticResource DefaultButtonStyle}" Click="OnEnableComponent"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </controls:ResponsiveColumns>
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="12">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="{loc:Loc Key=Pages/SoftwareManager_044}" Style="{StaticResource CardTitleStyle}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                            <Button Grid.Column="1" Content="{loc:Loc Key=Pages/Root_022}" Style="{StaticResource DefaultButtonStyle}" Click="OnClearLog"/>
                        </Grid>
                        <controls:LogView x:Name="Log" Height="180"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
