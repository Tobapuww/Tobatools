<Page
    x:Class="Tobatools.Pages.FileManagerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:loc="using:Tobatools.Services"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:Tobatools.Models"
    xmlns:controls="using:Tobatools.Controls"
    mc:Ignorable="d">

    <Page.Resources>
        <MenuFlyout x:Key="ItemMenuFlyout">
            <MenuFlyoutItem Text="{loc:Loc Key=Pages/FileManager_001}" Click="OnMenuOpen"/>
            <MenuFlyoutItem Text="{loc:Loc Key=Pages/FileManager_002}" Click="OnMenuExport"/>
            <MenuFlyoutSeparator/>
            <MenuFlyoutItem Text="{loc:Loc Key=Pages/FileManager_003}" Click="OnMenuCopy"/>
            <MenuFlyoutItem Text="{loc:Loc Key=Pages/FileManager_004}" Click="OnMenuCut"/>
            <MenuFlyoutItem Text="{loc:Loc Key=Pages/FileManager_005}" Click="OnMenuPaste"/>
            <MenuFlyoutSeparator/>
            <MenuFlyoutItem Text="{loc:Loc Key=Pages/FileManager_006}" Click="OnMenuRename"/>
            <MenuFlyoutItem Text="{loc:Loc Key=Pages/FileManager_007}" Click="OnMenuDelete"/>
            <MenuFlyoutItem Text="{loc:Loc Key=Pages/FileManager_008}" Click="OnMenuProps"/>
            <MenuFlyoutSeparator/>
            <MenuFlyoutItem Text="{loc:Loc Key=Pages/FileManager_009}" Click="OnMenuImportFiles"/>
            <MenuFlyoutItem Text="{loc:Loc Key=Pages/FileManager_010}" Click="OnMenuImportFolder"/>
            <MenuFlyoutSeparator/>
            <MenuFlyoutItem Text="{loc:Loc Key=Pages/SoftwareManager_006}" Click="OnMenuRefresh"/>
        </MenuFlyout>
    </Page.Resources>

    <Grid Background="{ThemeResource AppCanvasBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" ZoomMode="Disabled">
            <StackPanel Style="{StaticResource PageContentStyle}">
                <controls:PageHeader Title="{loc:Loc Key=Pages/FileManager_011}" Subtitle="{loc:Loc Key=Pages/FileManager_012}" IconData="{StaticResource FilesGlyph}"/>
                <controls:ResponsiveColumns FirstColumnWeight="7" SecondColumnWeight="3" Breakpoint="1040">

                <!-- 左：文件浏览 -->
                <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" VerticalAlignment="Top">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid.RowSpacing>12</Grid.RowSpacing>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8B7;" FontSize="18"/>
                            <TextBlock Text="{loc:Loc Key=Pages/FileManager_013}" Style="{StaticResource CardTitleStyle}" TextWrapping="Wrap"/>
                        </StackPanel>

                        <Grid Grid.Row="1" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Content="{loc:Loc Key=Pages/FileManager_014}" Style="{StaticResource DefaultButtonStyle}" Click="OnGoUp"/>
                            <TextBox x:Name="TxtPath" Grid.Column="1" Text="/storage/emulated/0"
                                     Style="{StaticResource RoundedTextBoxStyle}"/>
                            <Button Grid.Column="2" Content="{loc:Loc Key=Pages/FileManager_001}" Style="{StaticResource DefaultButtonStyle}"
                                    Click="OnGo"/>
                            <Button Grid.Column="3" Content="{loc:Loc Key=Pages/SoftwareManager_006}" Style="{StaticResource AccentButtonStyle}"
                                    Click="OnRefresh"/>
                        </Grid>

                        <ListView x:Name="ListFiles" Grid.Row="2" MinHeight="400" MaxHeight="560"
                                  SelectionMode="Single" IsItemClickEnabled="True" ItemClick="OnItemClick"
                                  DoubleTapped="OnListDoubleTapped"
                                  ContextFlyout="{StaticResource ItemMenuFlyout}"
                                  ItemContainerStyle="{StaticResource AppListContainerStyle}">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="local:FileItem">
                                    <Grid Padding="8,6" ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="80"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid ColumnSpacing="10" VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <Grid>
                                                <FontIcon Glyph="&#xE8B7;" Style="{StaticResource SectionIconStyle}"
                                                          Visibility="{x:Bind DirVisibility, Mode=OneWay}"/>
                                                <FontIcon Glyph="&#xE8A5;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                          Visibility="{x:Bind FileVisibility, Mode=OneWay}"/>
                                            </Grid>
                                            <TextBlock Grid.Column="1" Text="{x:Bind Name}" Style="{StaticResource BodyTextStyle}"
                                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Name}"/>
                                        </Grid>
                                        <TextBlock Grid.Column="1" Text="{x:Bind Size}" Style="{StaticResource CaptionTextStyle}"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="Wrap"/>
                                        <TextBlock Grid.Column="2" Text="{x:Bind TypeText}" Style="{StaticResource CaptionTextStyle}"
                                                   VerticalAlignment="Center" TextWrapping="Wrap"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>

                <!-- 右列 -->
                <StackPanel Grid.Column="1" Spacing="16">

                    <!-- 快捷操作 -->
                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel Spacing="14">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE771;" FontSize="18"/>
                                <TextBlock Text="{loc:Loc Key=Pages/Dashboard_015}" Style="{StaticResource CardTitleStyle}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Button x:Name="BtnPull" Content="{loc:Loc Key=Pages/FileManager_015}" Style="{StaticResource AccentButtonStyle}"
                                    HorizontalAlignment="Stretch" Click="OnPullSelected"/>
                        </StackPanel>
                    </Border>

                    <!-- 传输进度 -->
                    <Border x:Name="ProgressCard" Style="{StaticResource CardBorderStyle}" Visibility="Collapsed">
                        <StackPanel Spacing="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE823;" FontSize="18"/>
                                    <TextBlock Text="{loc:Loc Key=Pages/FileManager_016}" Style="{StaticResource CardTitleStyle}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <TextBlock x:Name="TxtProgress" Grid.Column="1" Text="0%"
                                           Style="{StaticResource CardSubtitleStyle}"
                                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" TextWrapping="Wrap"/>
                            </Grid>
                            <ProgressBar x:Name="ProgressBar" Maximum="100"/>
                            <TextBlock x:Name="TxtStatus" Text="{loc:Loc Key=Pages/FileManager_017}" Style="{StaticResource CaptionTextStyle}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- 使用提示 -->
                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel Spacing="16">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE946;" FontSize="18"/>
                                <TextBlock Text="{loc:Loc Key=Pages/FileManager_018}" Style="{StaticResource CardTitleStyle}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource CaptionTextStyle}" LineHeight="22" TextWrapping="Wrap"
                                       Text="{loc:Loc Key=Pages/FileManager_019}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
                </controls:ResponsiveColumns>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
