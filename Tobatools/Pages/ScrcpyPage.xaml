<Page
    x:Class="Tobatools.Pages.ScrcpyPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:loc="using:Tobatools.Services"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Tobatools.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource AppCanvasBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" ZoomMode="Disabled">
            <StackPanel Style="{StaticResource PageContentStyle}">
                <controls:PageHeader
                    Title="{loc:Loc Key=Pages/Scrcpy_001}"
                    Subtitle="{loc:Loc Key=Pages/Scrcpy_002}"
                    IconData="{StaticResource ScrcpyGlyph}" />

                <controls:ResponsiveColumns FirstColumnWeight="1.6" SecondColumnWeight="1" Spacing="24">
                    <StackPanel Spacing="16">
                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel Spacing="16">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Border Style="{StaticResource IconBadgeStyle}">
                                        <FontIcon Glyph="&#xE7F4;" Style="{StaticResource SectionIconStyle}" />
                                    </Border>
                                    <StackPanel VerticalAlignment="Center" Spacing="4">
                                        <TextBlock Text="{loc:Loc Key=Pages/Scrcpy_003}" Style="{StaticResource CardTitleStyle}"  TextWrapping="Wrap"/>
                                        <TextBlock Text="{loc:Loc Key=Pages/Scrcpy_004}" Style="{StaticResource CardSubtitleStyle}"  TextWrapping="Wrap"/>
                                    </StackPanel>
                                </StackPanel>

                                <Grid ColumnSpacing="16" RowSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <ComboBox
                                        x:Name="ComboMaxSize"
                                        Header="{loc:Loc Key=Pages/Scrcpy_005}"
                                        HorizontalAlignment="Stretch"
                                        Style="{StaticResource RoundedComboBoxStyle}" />
                                    <ComboBox
                                        x:Name="ComboFps"
                                        Grid.Column="1"
                                        Header="{loc:Loc Key=Pages/Scrcpy_006}"
                                        HorizontalAlignment="Stretch"
                                        Style="{StaticResource RoundedComboBoxStyle}" />
                                    <ComboBox
                                        x:Name="ComboBitrate"
                                        Grid.Row="1"
                                        Header="{loc:Loc Key=Pages/Scrcpy_007}"
                                        HorizontalAlignment="Stretch"
                                        Style="{StaticResource RoundedComboBoxStyle}" />
                                    <ComboBox
                                        x:Name="ComboVbuf"
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Header="{loc:Loc Key=Pages/Scrcpy_008}"
                                        HorizontalAlignment="Stretch"
                                        Style="{StaticResource RoundedComboBoxStyle}" />
                                    <ComboBox
                                        x:Name="ComboAbuf"
                                        Grid.Row="2"
                                        Header="{loc:Loc Key=Pages/Scrcpy_009}"
                                        HorizontalAlignment="Stretch"
                                        Style="{StaticResource RoundedComboBoxStyle}" />
                                    <CheckBox
                                        x:Name="ChkAudio"
                                        Grid.Row="2"
                                        Grid.Column="1"
                                        Content="{loc:Loc Key=Pages/Scrcpy_010}"
                                        IsChecked="True"
                                        VerticalAlignment="Bottom" />
                                </Grid>

                                <Border Height="1" Background="{ThemeResource AppBorderBrush}" />
                                <TextBlock Text="{loc:Loc Key=Pages/Scrcpy_011}" Style="{StaticResource SectionHeaderStyle}"  TextWrapping="Wrap"/>
                                <controls:WrapPanel Spacing="12">
                                    <CheckBox x:Name="ChkFullscreen" Content="{loc:Loc Key=Pages/Scrcpy_012}" />
                                    <CheckBox x:Name="ChkBorderless" Content="{loc:Loc Key=Pages/Scrcpy_013}" />
                                    <CheckBox x:Name="ChkAlwaysOnTop" Content="{loc:Loc Key=Pages/Scrcpy_014}" />
                                    <CheckBox x:Name="ChkDisableScreensaver" Content="{loc:Loc Key=Pages/Scrcpy_015}" />
                                    <CheckBox x:Name="ChkStayAwake" Content="{loc:Loc Key=Pages/Scrcpy_016}" />
                                    <CheckBox x:Name="ChkTurnScreenOff" Content="{loc:Loc Key=Pages/Scrcpy_017}" />
                                    <CheckBox x:Name="ChkShowTouches" Content="{loc:Loc Key=Pages/Scrcpy_018}" />
                                    <CheckBox x:Name="ChkClipSync" Content="{loc:Loc Key=Pages/Scrcpy_019}" IsChecked="True" />
                                    <CheckBox x:Name="ChkLegacyPaste" Content="{loc:Loc Key=Pages/Scrcpy_020}" />
                                    <CheckBox x:Name="ChkForwardAllClicks" Content="{loc:Loc Key=Pages/Scrcpy_021}" />
                                    <CheckBox x:Name="ChkPrintFps" Content="{loc:Loc Key=Pages/Scrcpy_022}" />
                                </controls:WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel Spacing="16">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE768;" Style="{StaticResource SectionIconStyle}" />
                                    <TextBlock Text="{loc:Loc Key=Pages/Scrcpy_023}" Style="{StaticResource CardTitleStyle}"  TextWrapping="Wrap"/>
                                </StackPanel>
                                <controls:WrapPanel Spacing="12">
                                    <Button
                                        x:Name="BtnStart"
                                        Content="{loc:Loc Key=Pages/Scrcpy_024}"
                                        MinWidth="144"
                                        Style="{StaticResource AccentButtonStyle}"
                                        Click="OnStart" />
                                    <Button
                                        x:Name="BtnStop"
                                        Content="{loc:Loc Key=Pages/Scrcpy_025}"
                                        MinWidth="144"
                                        IsEnabled="False"
                                        Style="{StaticResource DefaultButtonStyle}"
                                        Click="OnStop" />
                                </controls:WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <Border Style="{StaticResource CardBorderSubtleStyle}" VerticalAlignment="Top">
                        <StackPanel Spacing="16">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE946;" Style="{StaticResource SectionIconStyle}" />
                                <TextBlock Text="{loc:Loc Key=Pages/Scrcpy_026}" Style="{StaticResource CardTitleStyle}"  TextWrapping="Wrap"/>
                            </StackPanel>
                            <TextBlock
                                Text="{loc:Loc Key=Pages/Scrcpy_027}"
                                Style="{StaticResource SectionHeaderStyle}"  TextWrapping="Wrap"/>
                            <TextBlock
                                Text="{loc:Loc Key=Pages/Scrcpy_028}"
                                TextWrapping="Wrap"
                                Style="{StaticResource BodyTextStyle}" />
                            <TextBlock
                                Text="{loc:Loc Key=Pages/Scrcpy_029}"
                                Style="{StaticResource SectionHeaderStyle}"  TextWrapping="Wrap"/>
                            <TextBlock
                                Text="{loc:Loc Key=Pages/Scrcpy_030}"
                                TextWrapping="Wrap"
                                Style="{StaticResource BodyTextStyle}" />
                            <TextBlock
                                Text="{loc:Loc Key=Pages/Scrcpy_031}"
                                TextWrapping="Wrap"
                                Style="{StaticResource CaptionTextStyle}" />
                        </StackPanel>
                    </Border>
                </controls:ResponsiveColumns>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
