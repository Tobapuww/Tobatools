<Page
    x:Class="Tobatools.Pages.BackupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:loc="using:Tobatools.Services"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Tobatools.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource AppCanvasBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" ZoomMode="Disabled">
            <StackPanel Style="{StaticResource PageContentStyle}">
                <controls:PageHeader
                    Title="{loc:Loc Key=Pages/Backup_001}"
                    Subtitle="{loc:Loc Key=Pages/Backup_002}"
                    IconData="{StaticResource BackupGlyph}" />

                <Border Style="{StaticResource CardBorderSubtleStyle}">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon
                            Glyph="&#xE946;"
                            VerticalAlignment="Top"
                            Margin="0,2,0,0"
                            Style="{StaticResource SectionIconStyle}" />
                        <TextBlock
                            Grid.Column="1"
                            Text="{loc:Loc Key=Pages/Backup_003}"
                            TextWrapping="Wrap"
                            Style="{StaticResource BodyTextStyle}" />
                    </Grid>
                </Border>

                <controls:ResponsiveColumns Spacing="24">
                    <Border Style="{StaticResource CardBorderStyle}" VerticalAlignment="Top">
                        <StackPanel Spacing="16">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Border Style="{StaticResource IconBadgeStyle}">
                                    <FontIcon Glyph="&#xE8B7;" Style="{StaticResource SectionIconStyle}" />
                                </Border>
                                <TextBlock
                                    Text="{loc:Loc Key=Pages/Backup_004}"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource CardTitleStyle}"  TextWrapping="Wrap"/>
                            </StackPanel>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox
                                    x:Name="TxtPath"
                                    Header="{loc:Loc Key=Pages/Backup_005}"
                                    PlaceholderText="{loc:Loc Key=Pages/Backup_006}"
                                    Style="{StaticResource RoundedTextBoxStyle}" />
                                <Button
                                    Grid.Column="1"
                                    Content="{loc:Loc Key=Pages/Backup_007}"
                                    VerticalAlignment="Bottom"
                                    Style="{StaticResource DefaultButtonStyle}"
                                    Click="OnBrowse" />
                            </Grid>
                            <TextBlock
                                Text="{loc:Loc Key=Pages/Backup_008}"
                                TextWrapping="Wrap"
                                Style="{StaticResource CaptionTextStyle}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel Spacing="16">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Border Style="{StaticResource IconBadgeStyle}">
                                    <FontIcon Glyph="&#xE713;" Style="{StaticResource SectionIconStyle}" />
                                </Border>
                                <TextBlock
                                    Text="{loc:Loc Key=Pages/Backup_009}"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource CardTitleStyle}"  TextWrapping="Wrap"/>
                            </StackPanel>
                            <CheckBox x:Name="ChkZip" IsChecked="True">
                                <TextBlock Text="{loc:Loc Key=Pages/Backup_010}" TextWrapping="Wrap" />
                            </CheckBox>
                            <CheckBox x:Name="ChkScript" IsChecked="True">
                                <TextBlock
                                    Text="{loc:Loc Key=Pages/Backup_011}"
                                    TextWrapping="Wrap" />
                            </CheckBox>
                            <controls:WrapPanel Spacing="12">
                                <Button
                                    x:Name="BtnScan"
                                    Content="{loc:Loc Key=Pages/Backup_012}"
                                    Style="{StaticResource DefaultButtonStyle}"
                                    Click="OnScanPartitions" />
                                <Button
                                    x:Name="BtnStart"
                                    Content="{loc:Loc Key=Pages/Backup_013}"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Click="OnStartBackup" />
                            </controls:WrapPanel>
                            <ProgressBar x:Name="Progress" Maximum="100" Visibility="Collapsed" />
                        </StackPanel>
                    </Border>
                </controls:ResponsiveColumns>

                <Border Style="{StaticResource CardBorderStyle}">
                    <Grid RowSpacing="16" ColumnSpacing="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE9D9;" Style="{StaticResource SectionIconStyle}" />
                            <TextBlock Text="{loc:Loc Key=Pages/Root_020}" Style="{StaticResource CardTitleStyle}"  TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button
                            Grid.Column="1"
                            Content="{loc:Loc Key=Pages/Root_022}"
                            Style="{StaticResource DefaultButtonStyle}"
                            Click="OnClearLog" />
                        <controls:LogView x:Name="Log" Grid.Row="1" Grid.ColumnSpan="2" Height="300" />
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
