<Page
    x:Class="Tobatools.Pages.MiscPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:loc="using:Tobatools.Services"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Tobatools.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource AppCanvasBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" ZoomMode="Disabled">
            <StackPanel Style="{StaticResource PageContentStyle}">
                <controls:PageHeader
                    Title="{loc:Loc Key=Pages/Misc_001}"
                    Subtitle="{loc:Loc Key=Pages/Misc_002}"
                    IconData="{StaticResource MiscGlyph}" />

                <controls:ResponsiveColumns Spacing="24">
                    <StackPanel Spacing="16">
                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel Spacing="16">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource IconBadgeStyle}">
                                        <FontIcon Glyph="&#xE8B7;" Style="{StaticResource SectionIconStyle}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                        <TextBlock Text="{loc:Loc Key=Pages/Dashboard_022}" Style="{StaticResource CardTitleStyle}"  TextWrapping="Wrap"/>
                                        <TextBlock Text="{loc:Loc Key=Pages/Misc_003}" Style="{StaticResource CaptionTextStyle}"  TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Grid>
                                <StackPanel x:Name="CommonPanel" Spacing="8" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel Spacing="16">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource IconBadgeStyle}">
                                        <FontIcon Glyph="&#xE8A5;" Style="{StaticResource SectionIconStyle}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                        <TextBlock Text="{loc:Loc Key=Pages/Misc_004}" Style="{StaticResource CardTitleStyle}"  TextWrapping="Wrap"/>
                                        <TextBlock Text="{loc:Loc Key=Pages/Misc_005}" Style="{StaticResource CaptionTextStyle}"  TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Grid>
                                <StackPanel x:Name="AdvancedPanel" Spacing="8" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <Border Style="{StaticResource CardBorderStyle}" VerticalAlignment="Top">
                        <StackPanel Spacing="16">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource IconBadgeStyle}">
                                    <FontIcon Glyph="&#xE95E;" Style="{StaticResource SectionIconStyle}" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                    <TextBlock Text="{loc:Loc Key=Pages/Misc_006}" Style="{StaticResource CardTitleStyle}"  TextWrapping="Wrap"/>
                                    <TextBlock Text="{loc:Loc Key=Pages/Misc_007}" Style="{StaticResource CaptionTextStyle}"  TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                            <StackPanel x:Name="SimPanel" Spacing="8" />
                        </StackPanel>
                    </Border>
                </controls:ResponsiveColumns>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
