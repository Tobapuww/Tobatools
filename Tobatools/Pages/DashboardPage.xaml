<Page
    x:Class="Tobatools.Pages.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:loc="using:Tobatools.Services"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Tobatools.Controls"
    Loaded="OnLoaded" Unloaded="OnUnloaded">
    <Grid Background="{ThemeResource AppCanvasBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Style="{StaticResource PageContentStyle}">
                <controls:PageHeader Title="{loc:Loc Key=Pages/Dashboard_001}" Subtitle="{loc:Loc Key=Pages/Dashboard_002}" IconData="{StaticResource DashboardGlyph}"/>
                <InfoBar x:Name="ConnNotice" IsOpen="False" IsClosable="True" AutomationProperties.Name="{loc:Loc Key=Pages/Dashboard_083}"/>

                <!-- KPI 概览：设备块 + 电池 / 存储 / 内存三环 -->
                <controls:AdaptiveCards MinItemWidth="220">
                    <!-- 设备信息块 -->
                    <Border Style="{StaticResource CardBorderStyle}" Padding="16,12">
                        <Grid ColumnSpacing="12" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource IconBadgeStyle}" Width="40" Height="40">
                                <FontIcon Glyph="&#xE8A1;" FontSize="20" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtHeroModel" Text="{loc:Loc Key=Pages/Dashboard_004}" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="#86909c" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtHeroStatus" Text="{loc:Loc Key=Pages/Dashboard_005}" Style="{StaticResource BodyTextStyle}"/>
                                </StackPanel>
                                <TextBlock x:Name="TxtHeroSerial" Text="{loc:Loc Key=Pages/Dashboard_006}" Style="{StaticResource CaptionTextStyle}" FontFamily="{StaticResource MonoFont}" IsTextSelectionEnabled="True" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 电池 -->
                    <Border Style="{StaticResource CardBorderStyle}" Padding="16,12">
                        <Grid ColumnSpacing="12" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <controls:RingGauge x:Name="RingBattery" RingSize="72" AccentColor="#2BC3A8"/>
                            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="{loc:Loc Key=Pages/Dashboard_009}" Style="{StaticResource CardTitleStyle}" TextWrapping="Wrap"/>
                                <TextBlock x:Name="TxtBatteryDetail" Text="{loc:Loc Key=Pages/Dashboard_010}" Style="{StaticResource CardSubtitleStyle}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 存储 -->
                    <Border Style="{StaticResource CardBorderStyle}" Padding="16,12">
                        <Grid ColumnSpacing="12" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <controls:RingGauge x:Name="RingStorage" RingSize="72" AccentColor="#4098FF"/>
                            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="{loc:Loc Key=Pages/Dashboard_011}" Style="{StaticResource CardTitleStyle}" TextWrapping="Wrap"/>
                                <TextBlock x:Name="TxtStorageDetail" Text="{loc:Loc Key=Pages/Dashboard_010}" Style="{StaticResource CardSubtitleStyle}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 内存 -->
                    <Border Style="{StaticResource CardBorderStyle}" Padding="16,12">
                        <Grid ColumnSpacing="12" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <controls:RingGauge x:Name="RingMemory" RingSize="72" AccentColor="#A66BFF"/>
                            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="{loc:Loc Key=Pages/Dashboard_012}" Style="{StaticResource CardTitleStyle}" TextWrapping="Wrap"/>
                                <TextBlock x:Name="TxtMemoryDetail" Text="{loc:Loc Key=Pages/Dashboard_010}" Style="{StaticResource CardSubtitleStyle}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </controls:AdaptiveCards>

                <!-- 主体：左栏规格与参数，右栏快捷操作 -->
                <controls:ResponsiveColumns Breakpoint="900" FirstColumnWeight="2" SecondColumnWeight="1">
                    <StackPanel Spacing="16">
                        <!-- 规格速览 -->
                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel Spacing="16">
                                <TextBlock Text="{loc:Loc Key=Pages/Dashboard_093}" Style="{StaticResource CardTitleStyle}" TextWrapping="Wrap"/>
                                <StackPanel x:Name="SpecGrid" Spacing="12"/>
                            </StackPanel>
                        </Border>

                        <!-- 状态参数 -->
                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel Spacing="16">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{loc:Loc Key=Pages/Dashboard_094}" Style="{StaticResource CardTitleStyle}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                    <Button x:Name="BtnToggleParams" Grid.Column="1" Style="{StaticResource ToolCardButtonStyle}"
                                            Content="{loc:Loc Key=Pages/Dashboard_095}" Click="OnToggleParams"
                                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                </Grid>
                                <StackPanel x:Name="ParamGrid" Spacing="12"/>
                                <StackPanel x:Name="ExtraParams" Spacing="12" Margin="0,8,0,0" Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- 快捷操作 -->
                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel Spacing="16">
                            <!-- 设备选择 -->
                            <StackPanel Spacing="10">
                                <TextBlock Text="{loc:Loc Key=Pages/Dashboard_016}" Style="{StaticResource CardTitleStyle}" TextWrapping="Wrap"/>
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="DeviceSelector" AutomationProperties.Name="{loc:Loc Key=Pages/Dashboard_017}" Style="{StaticResource RoundedComboBoxStyle}"/>
                                    <Button Grid.Column="1" Style="{StaticResource DefaultButtonStyle}" ToolTipService.ToolTip="{loc:Loc Key=Pages/Dashboard_097}" Click="OnRefreshClick" VerticalAlignment="Stretch">
                                        <FontIcon Glyph="&#xE72C;" FontSize="14"/>
                                    </Button>
                                </Grid>
                            </StackPanel>

                            <Border Height="1" Background="{ThemeResource AppBorderBrush}"/>

                            <!-- 电源菜单 -->
                            <StackPanel Spacing="10">
                                <TextBlock Text="{loc:Loc Key=Pages/Dashboard_019}" Style="{StaticResource CardTitleStyle}" TextWrapping="Wrap"/>
                                <ComboBox x:Name="RebootMode" AutomationProperties.Name="{loc:Loc Key=Pages/Dashboard_020}" Style="{StaticResource RoundedComboBoxStyle}"/>
                                <Button Content="{loc:Loc Key=Pages/Dashboard_021}" HorizontalAlignment="Stretch" Style="{StaticResource AccentButtonStyle}" Click="OnRebootClick"/>
                            </StackPanel>

                            <Border Height="1" Background="{ThemeResource AppBorderBrush}"/>

                            <!-- 常用工具 -->
                            <StackPanel Spacing="10">
                                <TextBlock Text="{loc:Loc Key=Pages/Dashboard_022}" Style="{StaticResource CardTitleStyle}" TextWrapping="Wrap"/>
                                <StackPanel Spacing="10">
                                    <Button HorizontalAlignment="Stretch" Style="{StaticResource AccentButtonStyle}" Click="OnConnectClick">
                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE774;" FontSize="14"/>
                                            <TextBlock Text="{loc:Loc Key=Pages/Dashboard_007}"/>
                                        </StackPanel>
                                    </Button>
                                    <Button HorizontalAlignment="Stretch" Style="{StaticResource DefaultButtonStyle}" Click="OnRefreshClick">
                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE72C;" FontSize="14"/>
                                            <TextBlock Text="{loc:Loc Key=Pages/Dashboard_097}"/>
                                        </StackPanel>
                                    </Button>
                                    <Button HorizontalAlignment="Stretch" Style="{StaticResource DefaultButtonStyle}" Click="OnOpenDeviceManager">
                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE7F4;" FontSize="14"/>
                                            <TextBlock Text="{loc:Loc Key=Pages/Dashboard_028}"/>
                                        </StackPanel>
                                    </Button>
                                    <Button HorizontalAlignment="Stretch" Style="{StaticResource DefaultButtonStyle}" Click="OnRestartAdb">
                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE895;" FontSize="14"/>
                                            <TextBlock Text="{loc:Loc Key=Pages/Dashboard_027}"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </controls:ResponsiveColumns>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
