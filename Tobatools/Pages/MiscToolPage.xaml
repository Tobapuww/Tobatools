<Page
    x:Class="Tobatools.Pages.MiscToolPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{ThemeResource AppCanvasBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <!-- 设置式面包屑：父级可返回，当前工具作为页标题，窄窗口由 BreadcrumbBar 折叠。 -->
        <Grid Padding="32,24,32,16" HorizontalAlignment="Stretch">
            <BreadcrumbBar x:Name="ToolBreadcrumb" ItemClicked="OnBreadcrumbClicked"
                           AutomationProperties.Name="工具页面导航">
                <BreadcrumbBar.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" Style="{StaticResource PageTitleStyle}"
                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                    </DataTemplate>
                </BreadcrumbBar.ItemTemplate>
            </BreadcrumbBar>
        </Grid>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Style="{StaticResource PageContentStyle}" Padding="32,8,32,36">
                <TextBlock x:Name="ToolSubtitle" Style="{StaticResource CardSubtitleStyle}"/>
                <InfoBar x:Name="ToolNotice" IsOpen="False" IsClosable="True"/>
                <Border Style="{StaticResource CardBorderStyle}">
                    <ContentControl x:Name="Host" HorizontalContentAlignment="Stretch"/>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
