    <Style x:Key="NavigationIconStyle" TargetType="PathIcon">
        <Setter Property="Width" Value="20"/>
        <Setter Property="Height" Value="20"/>
    </Style>

    <FontFamily x:Key="AppFont">Segoe UI Variable, Microsoft YaHei UI, Microsoft YaHei</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, Microsoft YaHei UI</FontFamily>
    <Thickness x:Key="PagePadding">32,28,32,36</Thickness>

    <!-- 页面内容不允许设置 MaxWidth：一旦内容宽度被限制，
         HorizontalAlignment=Stretch 会在超额宽度中把内容居中，
         最大化时整页就往中间缩，右侧留出大片空白且控件跑出可视区。
         这里始终左对齐并铺满可用宽度。 -->
    <Style x:Key="PageContentStyle" TargetType="StackPanel">
        <Setter Property="Padding" Value="{StaticResource PagePadding}"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="Spacing" Value="24"/>
    </Style>
    <Style x:Key="CardBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource AppSurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource AppBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="20"/>
    </Style>
    <Style x:Key="CardBorderSubtleStyle" TargetType="Border" BasedOn="{StaticResource CardBorderStyle}">
        <Setter Property="Background" Value="{ThemeResource AppSubtleBrush}"/>
        <Setter Property="Padding" Value="16"/>
        <Setter Property="CornerRadius" Value="10"/>
    </Style>
    <Style x:Key="IconBadgeStyle" TargetType="Border">
        <Setter Property="Width" Value="40"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Background" Value="{ThemeResource AppAccentSoftBrush}"/>
    </Style>
    <Style x:Key="SectionIconStyle" TargetType="FontIcon">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
    </Style>

    <Style x:Key="BodyTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="PageTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextStyle}">
        <Setter Property="FontSize" Value="28"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="SectionHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextStyle}">
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>
    <Style x:Key="CardTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextStyle}">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="CardSubtitleStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextStyle}">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
    </Style>
    <Style x:Key="CaptionTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CardSubtitleStyle}">
        <Setter Property="FontSize" Value="12"/>
    </Style>

    <!-- 保留 WinUI 原生按钮模板：悬停、按下、禁用、键盘焦点均由系统处理。 -->
    <Style x:Key="DefaultButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Background" Value="{ThemeResource AppControlBrush}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource AppBorderBrush}"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="Padding" Value="14,8"/>
        <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
    </Style>
    <Style x:Key="AccentButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
    </Style>
    <Style x:Key="RoundedTextBoxStyle" TargetType="TextBox">
        <Setter Property="Background" Value="{ThemeResource AppControlBrush}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource AppBorderBrush}"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
    </Style>
    <Style x:Key="RoundedComboBoxStyle" TargetType="ComboBox">
        <Setter Property="Background" Value="{ThemeResource AppControlBrush}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource AppBorderBrush}"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
    </Style>
    <Style x:Key="ToolCardButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="UseSystemFocusVisuals" Value="True"/>
    </Style>
    <Style x:Key="ListCardButtonStyle" TargetType="Button" BasedOn="{StaticResource ToolCardButtonStyle}">
        <Setter Property="Padding" Value="12,12"/>
        <Setter Property="Margin" Value="0,2"/>
    </Style>
    <Style x:Key="InfoItemBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource AppSubtleBrush}"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="12"/>
    </Style>
    <Style x:Key="AppListContainerStyle" TargetType="ListViewItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Padding" Value="4,6"/>
        <Setter Property="Margin" Value="0,2"/>
        <Setter Property="CornerRadius" Value="8"/>
    </Style>
    <Style x:Key="LogTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="IsTextSelectionEnabled" Value="True"/>
    </Style>
    <Style x:Key="LogStepTextStyle" TargetType="TextBlock" BasedOn="{StaticResource LogTextStyle}">
        <Setter Property="Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
    </Style>
    <Style x:Key="LogSuccessTextStyle" TargetType="TextBlock" BasedOn="{StaticResource LogTextStyle}">
        <Setter Property="Foreground" Value="{ThemeResource SystemFillColorSuccessBrush}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="LogErrorTextStyle" TargetType="TextBlock" BasedOn="{StaticResource LogTextStyle}">
        <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="StepBadgeSuccess" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource SystemFillColorSuccessBrush}"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="6,2"/>
    </Style>
    <Style x:Key="StepBadgeFail" TargetType="Border" BasedOn="{StaticResource StepBadgeSuccess}">
        <Setter Property="Background" Value="{ThemeResource SystemFillColorCriticalBrush}"/>
    </Style>
    <Style x:Key="StepBadgeRun" TargetType="Border" BasedOn="{StaticResource StepBadgeSuccess}">
        <Setter Property="Background" Value="{ThemeResource SystemFillColorAttentionBrush}"/>
    </Style>
</ResourceDictionary>
